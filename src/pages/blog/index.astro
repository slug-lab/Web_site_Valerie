---
// Référence : references/update_du_22_11/SITE INTERNET Maison Clovali.pdf, p. 9
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import ContactStrip from '../../components/ContactStrip.astro';
import Divider from '../../components/Divider.astro';
import { posts } from '../../data/blog';
---

<BaseLayout
  title="Blog"
  description="Le blog de Maison Clovali : conseils et actualités autour de votre propriété — location saisonnière, obligations des propriétaires et conciergerie privée en Provence."
>
  <section class="grid nav:min-h-[232px] nav:grid-cols-[51fr_49fr]">
    <div class="px-4 py-8 text-center sm:px-6 nav:py-0 nav:pl-[70px] nav:pr-[80px] nav:pt-[26px]">
      <h1 class="font-serif text-[2.2rem] font-normal uppercase tracking-[0.12em] text-olive-dark md:text-[2.35rem]">Le blog</h1>
      <p class="mx-auto mt-5 max-w-[520px] font-sans text-[1.15rem] uppercase leading-[1.45] tracking-[0.1em] text-olive-dark md:text-[1.45rem]">
        Conseils &amp; actualités autour de votre propriété
      </p>
      <Divider class="mx-auto mt-5 w-full max-w-[545px]" sprigClass="h-9 w-14" />
    </div>
    <div class="h-40 sm:h-52 nav:mt-[10px] nav:h-[232px]">
      <img src="/images/olivier.webp" alt="" class="h-full w-full object-cover object-right" width="978" height="248" />
    </div>
  </section>

  <section class="container-site pt-8 nav:pt-[20px] nav:pl-[56px] nav:pr-[30px]" aria-label="Articles">
    <ul class="grid gap-10 lg:grid-cols-2 lg:gap-x-[28px] lg:gap-y-[36px]">
      {
        posts.map((post) => (
          <li>
            <article class="grid gap-4 sm:grid-cols-[242px_1fr] sm:gap-[14px] lg:grid-cols-[180px_1fr] nav:grid-cols-[242px_1fr]">
              <a href={`/blog/${post.slug}/`} tabindex="-1" aria-hidden="true">
                <img src={post.image.src} alt="" class="aspect-[242/124] w-full rounded-xl object-cover" width={post.image.width} height={post.image.height} loading="lazy" />
              </a>
              <div>
                <h2 class="font-sans text-[1.15rem] font-medium leading-[1.2] text-olive-dark">
                  <a href={`/blog/${post.slug}/`} class="hover:text-gold">{post.cardTitle}</a>
                </h2>
                <p class="mt-2 text-[0.97rem] leading-[1.25] text-olive">{post.excerpt}</p>
                <a href={`/blog/${post.slug}/`} class="mt-2 inline-block font-sans text-[0.85rem] uppercase text-gold hover:text-olive-dark">
                  Lire l’article<span class="sr-only"> : {post.title}</span>
                </a>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="container-site flex flex-col items-start gap-8 pb-10 pt-10 md:flex-row md:items-end md:justify-between nav:pb-[36px] nav:pl-[56px] nav:pr-[32px] nav:pt-[42px]">
    <Button href="/" class="min-h-[60px] px-4 text-[1rem] md:text-[1.05rem]">Revenir à la page d’accueil ➔</Button>
    <ContactStrip class="w-full md:max-w-[590px]" />
  </div>
</BaseLayout>
