---
// Référence : references/update_du_22_11/SITE INTERNET Maison Clovali.pdf, p. 10–11, 12–13 et 14–17
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactStrip from '../../components/ContactStrip.astro';
import Divider from '../../components/Divider.astro';
import { posts, type BlogPost } from '../../data/blog';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: BlogPost };
---

<BaseLayout title={post.title} description={post.description} image={post.image.src}>
  <article class="container-site pb-10 nav:pb-[36px] lg:pl-[28px] lg:pr-[32px]">
    <header class="grid gap-6 pt-6 lg:grid-cols-[1fr_336px] lg:gap-10 nav:pt-[20px]">
      <div class="lg:pt-[18px]">
        <h1 class="font-sans text-[1.7rem] font-medium leading-[1.15] tracking-[0.04em] text-olive-dark md:text-[2.15rem]">{post.title}</h1>
        <Divider class="mt-4 w-full max-w-[635px]" sprigClass="h-9 w-14" />
        <p class="mt-3 text-[1.05rem] leading-[1.3] tracking-[0.1em] text-olive-dark md:text-[1.15rem]">{post.standfirst}</p>
      </div>
      <img src={post.image.src} alt={post.image.alt} class="order-first aspect-[336/156] w-full max-w-[336px] object-cover lg:order-none" width={post.image.width} height={post.image.height} />
    </header>

    <hr class="mt-6 border-olive-dark/40" />
    <p class="mt-6 text-[1.05rem] leading-[1.35] text-olive-dark md:text-[1.12rem]">{post.intro}</p>

    <ol class="mt-10 flex flex-col gap-10 md:pl-[24px]">
      {
        post.sections.map((section, i) => (
          <li class="grid grid-cols-[44px_1fr] gap-x-3 sm:grid-cols-[52px_1fr] sm:gap-x-[18px]">
            <span class="badge-number h-[44px] w-[44px] text-[1.15rem] sm:h-[52px] sm:w-[52px] sm:text-[1.3rem]" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="sm:pt-[12px]">
              <h2 class="font-sans text-[1.1rem] font-semibold leading-snug text-olive-dark md:text-[1.15rem]">{section.title}</h2>
              <div class="mt-3 space-y-1 text-[1rem] leading-[1.55] text-olive md:max-w-[1140px] md:text-[1.02rem]">
                {section.blocks.map((block) =>
                  block.type === 'h' ? (
                    <h3 class="pt-2 font-semibold text-olive-dark">{block.text}</h3>
                  ) : block.type === 'list' ? (
                    <ul class="list-disc pl-[34px] marker:text-olive-dark">
                      {block.items.map((item) => <li>{item}</li>)}
                    </ul>
                  ) : (
                    <p>
                      {block.lead && <strong class="font-semibold text-olive-dark">{block.lead} </strong>}
                      {block.text}
                    </p>
                  ),
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ol>

    {
      post.takeaway && (
        <aside class="mt-10 rounded-[28px] bg-ivory px-5 pb-8 pt-5 sm:px-[26px]" aria-labelledby="essentiel-title">
          <div class="flex items-center gap-5">
            <img src="/images/icone-liste.png" alt="" class="h-[52px] w-[52px] shrink-0" width="61" height="61" />
            <div>
              <h2 id="essentiel-title" class="font-sans text-[1.15rem] font-medium text-olive-dark">{post.takeaway.title}</h2>
              <p class="text-[0.95rem] text-olive-dark">{post.takeaway.subtitle}</p>
            </div>
          </div>
          <hr class="mt-5 border-gold" />
          <div class="mt-6 text-[1rem] leading-[1.55] text-olive-dark">
            {post.takeaway.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <hr class="mt-8 border-gold" />
        </aside>
      )
    }

    <ContactStrip class="mt-8 md:ml-auto md:max-w-[590px]" />
  </article>
</BaseLayout>
