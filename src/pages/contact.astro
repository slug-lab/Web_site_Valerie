---
// Maquette : references/Page _CONTACT.png
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Divider from '../components/Divider.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Contact"
  description="Parlons de votre projet : contactez Maison Clovali, conciergerie privée à Meyrargues, au 07 85 74 25 96, par e-mail ou via le formulaire."
>
  <div class="relative isolate pb-10 nav:pb-[26px]">
    <img src="/images/hero-accueil.webp" alt="" class="absolute inset-0 -z-20 h-full w-full object-cover [filter:sepia(.35)_saturate(.7)_blur(1px)]" width="1920" height="1080" />
    <div class="absolute inset-0 -z-10 bg-cream/65" aria-hidden="true"></div>

    <header class="container-site pt-8 text-center nav:pt-[24px]">
      <h1 class="font-serif text-[1.9rem] font-bold uppercase tracking-[0.1em] text-olive-dark md:text-[2.2rem]">Parlons de votre projet</h1>
      <Divider class="mx-auto mt-3 w-full max-w-[1058px]" sprigClass="h-9 w-11" lineClass="bg-olive-dark/60" />
      <p class="mt-5 font-sans text-lg uppercase tracking-[0.1em] text-olive-dark md:text-[1.35rem]">
        Nous sommes à votre écoute pour vous accompagner
      </p>
    </header>

    <div class="container-site mt-6 grid gap-6 nav:mt-[20px] nav:grid-cols-[361px_626px] nav:justify-between nav:pl-[115px] nav:pr-[136px]">
      <aside class="bg-grey-card/95 px-8 py-6 nav:px-[30px] nav:py-[18px]" aria-labelledby="direct-title">
        <h2 id="direct-title" class="text-center font-serif text-xl font-bold uppercase leading-snug tracking-[0.12em] text-olive-dark">
          Vous préférez nous joindre directement&nbsp;?
        </h2>
        <Divider class="mx-auto mt-6 w-full max-w-[258px]" sprigClass="h-8 w-10" lineClass="bg-olive-dark/60" />
        <p class="mt-6 text-center font-serif text-[1.2rem] font-semibold italic leading-[1.6] text-olive-dark">
          Nous sommes à votre disposition pour répondre à vos questions et échanger sur votre projet
        </p>
        <address class="mt-10 space-y-6 not-italic nav:mt-[56px]">
          <p class="flex items-center gap-6">
            <Icon name="home" class="h-8 w-8 shrink-0 text-olive-dark" />
            <span class="text-lg leading-tight text-ink">{site.name}<br /><span class="text-base text-sage">{site.town}</span></span>
          </p>
          <p class="flex items-center gap-6">
            <Icon name="phone" class="h-8 w-8 shrink-0 text-olive-dark" />
            <a href={`tel:${site.phoneHref}`} class="text-lg text-ink hover:text-gold">{site.phone}</a>
          </p>
          <p class="flex items-center gap-6">
            <Icon name="mail" class="h-8 w-8 shrink-0 text-olive-dark" />
            <a href={`mailto:${site.email}`} class="break-all text-lg text-ink underline underline-offset-2 hover:text-gold">{site.email}</a>
          </p>
        </address>
      </aside>

      <section class="bg-cream-card/95 px-5 py-5 sm:px-6 nav:pl-[20px] nav:pr-[20px] nav:py-[18px]" aria-labelledby="form-title">
        <h2 id="form-title" class="font-serif text-xl font-bold uppercase tracking-[0.12em] text-olive-dark nav:pl-[2px]">Écrivez-nous</h2>
        <Divider class="mt-2 w-[258px]" sprigClass="h-8 w-10" lineClass="bg-olive-dark/60" />
        <p class="mt-3 font-serif text-[1.2rem] font-semibold italic leading-snug text-olive-dark">
          Remplissez le formulaire ci-dessous et nous reviendrons vers vous dans les meilleurs délais.
        </p>
        <ContactForm />
      </section>
    </div>
  </div>
</BaseLayout>
