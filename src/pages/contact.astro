---
// Référence : references/update_du_22_11/SITE INTERNET Maison Clovali.pdf, p. 8
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Divider from '../components/Divider.astro';
import Icon from '../components/Icon.astro';
import Sprig from '../components/Sprig.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Contact"
  description="Parlons de votre projet : contactez Maison Clovali, conciergerie privée à Meyrargues, au 07 85 74 25 96, par e-mail ou via le formulaire."
>
  <div class="grid nav:grid-cols-[312px_minmax(0,1fr)]">
    <div class="relative hidden nav:mt-[26px] nav:block">
      <img src="/images/contact-porte.webp" alt="" class="absolute inset-0 h-full w-full object-cover object-[70%_50%]" width="312" height="661" />
    </div>

    <div class="px-4 pb-10 sm:px-6 nav:pb-[26px] nav:pl-[27px] nav:pr-[34px]">
      <header class="pt-8 text-center nav:pt-[22px]">
        <h1 class="font-serif text-[1.9rem] font-normal uppercase tracking-[0.14em] text-olive-dark md:text-[2.2rem]">Parlons de votre projet</h1>
        <Divider class="mx-auto -mt-1 w-full max-w-[750px]" sprigClass="h-9 w-14" />
        <p class="mt-2 font-sans text-[1.05rem] uppercase tracking-[0.1em] text-olive-dark md:text-[1.3rem]">
          Nous sommes à votre écoute pour vous accompagner
        </p>
      </header>

      <div class="mt-6 grid gap-6 lg:grid-cols-[334fr_627fr] lg:gap-[32px] nav:mt-[20px]">
        <aside class="flex flex-col rounded-[14px] bg-sage px-6 py-7 text-white shadow-[0_4px_14px_rgba(84,92,77,0.18)] sm:px-[26px]" aria-labelledby="direct-title">
          <h2 id="direct-title" class="text-center font-sans text-[1.15rem] font-medium uppercase leading-snug tracking-[0.1em] md:text-[1.2rem]">
            Vous préférez nous joindre directement&nbsp;?
          </h2>
          <div class="mx-auto mt-6 flex w-full max-w-[282px] items-center gap-4" aria-hidden="true">
            <span class="h-px flex-1 bg-white/80"></span>
            <Sprig class="h-7 w-10 brightness-0 invert" />
            <span class="h-px flex-1 bg-white/80"></span>
          </div>
          <p class="mt-6 text-center text-[1.1rem] leading-[1.45]">
            Nous sommes à votre disposition pour répondre à vos questions et échanger sur votre projet
          </p>
          <span class="mx-auto mt-6 block h-px w-[110px] bg-white/80" aria-hidden="true"></span>
          <address class="mt-8 space-y-6 not-italic">
            <p class="flex items-center gap-5">
              <Icon name="home" class="h-8 w-8 shrink-0" />
              <span class="text-[1.1rem] leading-tight">{site.name}<br /><span class="text-base">{site.town}</span></span>
            </p>
            <p class="flex items-center gap-5">
              <Icon name="phone" class="h-8 w-8 shrink-0" />
              <a href={`tel:${site.phoneHref}`} class="text-[1.15rem] hover:underline">{site.phone}</a>
            </p>
            <p class="flex items-center gap-5">
              <Icon name="mail" class="h-8 w-8 shrink-0" />
              <a href={`mailto:${site.email}`} class="break-all text-[1.1rem] underline underline-offset-2">{site.email}</a>
            </p>
          </address>
        </aside>

        <section class="rounded-2xl border border-olive-dark/10 bg-cream px-5 py-5 shadow-[0_6px_24px_rgba(84,92,77,0.15)] sm:px-[24px]" aria-labelledby="form-title">
          <h2 id="form-title" class="font-sans text-[1.25rem] font-medium uppercase tracking-[0.1em] text-olive-dark">Écrivez-nous</h2>
          <p class="mt-5 text-[1.1rem] leading-snug text-olive-dark md:text-[1.2rem]">
            Remplissez le formulaire ci-dessous et nous reviendrons vers vous dans les meilleurs délais.
          </p>
          <ContactForm />
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
