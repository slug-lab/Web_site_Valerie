---
// Rameau d'olivier — ornement récurrent des maquettes.
// Picto fourni par la MOA le 24/10 (references/update_du_24_10/Feuille_vert olive_1.png) :
// horizontal pour les séparateurs, vertical (feuille-olive-verticale.webp) pour les encarts.
interface Props {
  class?: string;
  vertical?: boolean;
}
const { class: className = 'h-9 w-11', vertical = false } = Astro.props;
const src = vertical ? '/images/feuille-olive-verticale.webp' : '/images/feuille-olive.webp';
const [width, height] = vertical ? [157, 200] : [240, 195];
---

<img src={src} alt="" aria-hidden="true" class:list={['object-contain', className]} width={width} height={height} decoding="async" />
