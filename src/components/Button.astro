---
import type { HTMLAttributes } from 'astro/types';

// Boutons de la charte du 22/11/2026 (§ 9) :
// primary = plein vert #6E7965, secondary = contour vert foncé sur fond clair,
// light = fond ivoire sur aplat sauge (bloc « Vous êtes propriétaire ? »), submit = envoi du formulaire.
type Variant = 'primary' | 'secondary' | 'light' | 'submit';

type Props = (HTMLAttributes<'a'> | HTMLAttributes<'button'>) & {
  href?: string;
  variant?: Variant;
  class?: string;
};

const { href, variant = 'primary', class: className = '', ...rest } = Astro.props;

const variants: Record<Variant, string> = {
  primary: 'bg-olive text-white hover:bg-olive-dark',
  secondary: 'border-2 border-olive-dark/70 bg-ivory text-olive-dark hover:bg-olive-dark hover:text-white',
  light: 'bg-ivory text-olive-dark hover:bg-olive-dark hover:text-white',
  submit: 'w-full rounded-none bg-olive text-white hover:bg-olive-dark disabled:cursor-wait disabled:opacity-70',
};
const classes = ['btn', variants[variant], className];
---

{
  href ? (
    <a href={href} class:list={classes} {...(rest as HTMLAttributes<'a'>)}>
      <slot />
    </a>
  ) : (
    <button class:list={classes} {...(rest as HTMLAttributes<'button'>)}>
      <slot />
    </button>
  )
}
