---
// Pictogrammes SVG (temporaires, dessinés d'après les maquettes).
export type IconName =
  | 'check'
  | 'quote'
  | 'home'
  | 'phone'
  | 'mail'
  | 'pin'
  | 'proximite'
  | 'reactivite'
  | 'disponibilite'
  | 'exigence'
  | 'keys';

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className = 'h-6 w-6' } = Astro.props;
const stroke = { fill: 'none', stroke: 'currentColor', 'stroke-width': 1.6, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const;
---

<svg class={className} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  {name === 'check' && <path d="M8 26l9 12L40 6" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />}
  {
    name === 'quote' && (
      <g fill="currentColor" transform="rotate(180 24 24)">
        <path d="M6 30c0-8 4-14 11-17l1.5 2.6C14 18 12 21 12 24.5h1.5a5.5 5.5 0 1 1-7.5 5.5z" />
        <path d="M25 30c0-8 4-14 11-17l1.5 2.6C33 18 31 21 31 24.5h1.5a5.5 5.5 0 1 1-7.5 5.5z" />
      </g>
    )
  }
  {name === 'home' && <path fill="currentColor" d="M24 6L3 24h6v18h11V31h8v11h11V24h6L36 15V8h-5v3z" />}
  {
    name === 'phone' && (
      <path
        fill="currentColor"
        d="M13.5 4.5l6 8.5c.8 1.2.6 2.8-.5 3.7l-3.3 2.8c2.6 5.4 6.8 9.7 12.2 12.4l2.8-3.3c1-1.1 2.6-1.3 3.8-.5l8.5 6c1.3.9 1.6 2.7.7 4l-2.2 3.2c-1.5 2.1-4.2 3-6.6 2.1C20.6 38.6 9.4 27.4 4.6 13.1c-.8-2.5.1-5.1 2.2-6.6L10 4.3c1.2-.9 2.9-.8 3.5.2z"
      />
    )
  }
  {
    name === 'mail' && (
      <g fill="currentColor">
        <path d="M4 10h40v4L24 27 4 14z" />
        <path d="M4 18l20 13 20-13v20H4z" />
      </g>
    )
  }
  {
    name === 'pin' && (
      <g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M24 44S10 28.5 10 19a14 14 0 0 1 28 0c0 9.5-14 25-14 25z" />
        <circle cx="24" cy="19" r="5.5" />
      </g>
    )
  }
  {
    name === 'proximite' && (
      <g {...stroke}>
        <circle cx="15" cy="19" r="5" />
        <circle cx="33" cy="19" r="5" />
        <path d="M5 40c0-7 4-11 10-11 3 0 5 1 7 3l4 4M43 40c0-7-4-11-10-11-3 0-5 1-7 3l-5 4c-1 1 0 3 2 3h5" />
        <path d="M24 4v4M17 6l2 3.5M31 6l-2 3.5" />
      </g>
    )
  }
  {
    name === 'reactivite' && (
      <g {...stroke}>
        <circle cx="30" cy="24" r="14" />
        <path d="M30 15v9l6 4M2 18h12M6 24h8M2 30h12" />
      </g>
    )
  }
  {
    name === 'disponibilite' && (
      <g {...stroke}>
        <path d="M30 9a16 16 0 1 0-6 30" />
        <path d="M22 14v10l6 3M39 8l3-3M42 14h4M38 3v3" />
        <circle cx="35" cy="28" r="4.5" />
        <path d="M27 43c0-5 3.5-8 8-8s8 3 8 8" />
      </g>
    )
  }
  {
    name === 'exigence' && (
      <g {...stroke}>
        <path d="M24 3l4 3 5-.5 2 4.5 4.5 2-.5 5 3 4-3 4 .5 5-4.5 2-2 4.5-5-.5-4 3-4-3-5 .5-2-4.5-4.5-2 .5-5-3-4 3-4-.5-5 4.5-2 2-4.5 5 .5z" />
        <circle cx="24" cy="21" r="9" />
        <path d="M20 21l3 3 6-6M16 35l-4 10 5-2 3 4 3-9M32 35l4 10-5-2-3 4-3-9" />
      </g>
    )
  }
  {
    name === 'keys' && (
      <g {...stroke} stroke-width="2.6">
        <circle cx="21" cy="10" r="5" />
        <circle cx="30" cy="13" r="6.5" />
        <circle cx="30" cy="13" r="2" />
        <path d="M25.5 17.5L8 35M12 31l3.5 3.5M15.5 27.5l2.5 2.5M8 35l-2 4 4-2" />
        <path d="M24.5 13.5l9.5 9" />
        <path d="M33 22l5 3 2 13-6 3-4-12z" />
        <circle cx="34.5" cy="27.5" r="1.3" />
      </g>
    )
  }
</svg>
