---
// Pictogrammes SVG (temporaires, dessinés d'après les maquettes).
export type IconName =
  | 'check'
  | 'quote'
  | 'home'
  | 'phone'
  | 'mail';

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className = 'h-6 w-6' } = Astro.props;
---

<svg class={className} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  {name === 'check' && <path d="M8 26l9 12L40 6" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />}
  {
    name === 'quote' && (
      <g fill="currentColor" transform="rotate(180 24 24)">
        <path d="M6 30c0-8 4-14 11-17l1.5 2.6C14 18 12 21 12 24.5h1.5a5.5 5.5 0 1 1-7.5 5.5z" />
        <path d="M25 30c0-8 4-14 11-17l1.5 2.6C33 18 31 21 31 24.5h1.5a5.5 5.5 0 1 1-7.5 5.5z" />
      </g>
    )
  }
  {name === 'home' && <path fill="currentColor" d="M24 6L3 24h6v18h11V31h8v11h11V24h6L36 15V8h-5v3z" />}
  {
    name === 'phone' && (
      <path
        fill="currentColor"
        d="M13.5 4.5l6 8.5c.8 1.2.6 2.8-.5 3.7l-3.3 2.8c2.6 5.4 6.8 9.7 12.2 12.4l2.8-3.3c1-1.1 2.6-1.3 3.8-.5l8.5 6c1.3.9 1.6 2.7.7 4l-2.2 3.2c-1.5 2.1-4.2 3-6.6 2.1C20.6 38.6 9.4 27.4 4.6 13.1c-.8-2.5.1-5.1 2.2-6.6L10 4.3c1.2-.9 2.9-.8 3.5.2z"
      />
    )
  }
  {
    name === 'mail' && (
      <g fill="currentColor">
        <path d="M4 10h40v4L24 27 4 14z" />
        <path d="M4 18l20 13 20-13v20H4z" />
      </g>
    )
  }
</svg>
