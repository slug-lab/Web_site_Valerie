---
import Icon from './Icon.astro';

// « Ils nous font confiance »
// `example: true` = AVIS D'EXEMPLE rédigé pour la mise en page : ce n'est PAS un vrai témoignage.
// À remplacer par des avis réels (avec l'accord de leurs auteurs) AVANT la mise en ligne :
// publier de faux avis est une pratique commerciale trompeuse (Code de la consommation, art. L121-4).
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const reviews: { text: string; author: string; example?: boolean }[] = [
  // Témoignage réel transmis par la cliente le 11/10/2026.
  {
    text: 'J’ai travaillé avec Valérie pendant 5 ans et je peux témoigner de son sérieux, de sa fiabilité et de son sens des responsabilités. C’est une personne de confiance, je lui confierais ma maison les yeux fermés.',
    author: 'Marie C. — Ancienne collègue de travail, cinq ans de collaboration',
  },
  {
    example: true,
    text: 'Vivant à l’étranger, je cherchais quelqu’un de confiance pour ma maison. Les visites régulières et les photos envoyées me rassurent tout au long de l’année.',
    author: 'Propriétaire à Venelles — Intendance annuelle',
  },
  {
    example: true,
    text: 'Réactivité remarquable : une fuite un dimanche soir, un artisan sur place le lendemain matin. Nos locataires n’ont rien remarqué.',
    author: 'Propriétaires à Pertuis — formule Essentiel',
  },
];
---

<section class:list={['pb-10', className]} aria-labelledby="avis-title">
  <div class="flex items-center gap-5 px-4 sm:px-[17px]">
    <span class="h-px flex-1 bg-olive-dark/70" aria-hidden="true"></span>
    <h2 id="avis-title" class="text-center font-sans text-xl font-normal uppercase text-olive-dark sm:text-2xl">
      Ils nous font confiance
    </h2>
    <span class="h-px flex-1 bg-olive-dark/70" aria-hidden="true"></span>
  </div>
  <ul class="container-site mt-3 grid gap-4 md:grid-cols-3 md:gap-8 lg:gap-[73px] lg:px-[42px]">
    {
      reviews.map((review) => (
        <li class="h-full">
          <figure class="flex h-full gap-4 bg-[#ececec] px-5 py-4">
            <Icon name="quote" class="h-7 w-7 shrink-0 text-olive" />
            <div class="flex flex-1 flex-col">
              <blockquote class="font-serif text-[1.1rem] italic leading-snug text-ink">
                <p>{review.text}</p>
              </blockquote>
              <figcaption class="mt-auto pt-3 text-sm text-olive-dark/80">{review.author}</figcaption>
            </div>
          </figure>
        </li>
      ))
    }
  </ul>
</section>
