---
// Formulaire de contact — envoyé au service Web3Forms (https://web3forms.com, offre gratuite : 250 envois/mois),
// qui transmet la demande par e-mail à l'adresse associée à la clé d'accès (site.web3formsKey).
import Button from './Button.astro';
import { site } from '../data/site';

// Page de remerciement utilisée si JavaScript est désactivé (envoi classique du formulaire).
const redirect = new URL('/merci/', Astro.site).href;

const projectOptions = ['La location saisonnière', 'L’intendance de ma propriété', 'Les deux', 'Autre'];
const label = 'block text-[0.95rem] text-ink';
const input =
  'mt-0.5 block h-8 w-full border border-[#9a9a9a] bg-white px-2 py-1 text-base text-ink transition-colors focus:border-olive-dark focus:outline-none focus:ring-1 focus:ring-olive-dark user-invalid:border-[#a0453a]';
---

<form action="https://api.web3forms.com/submit" method="POST" class="relative mt-4" data-contact-form data-email={site.email} novalidate>
  <!-- Paramètres Web3Forms -->
  <input type="hidden" name="access_key" value={site.web3formsKey} />
  <input type="hidden" name="subject" value="Nouvelle demande depuis le site Maison Clovali" />
  <input type="hidden" name="from_name" value="Site Maison Clovali" />
  <input type="hidden" name="redirect" value={redirect} />
  <!-- Champ piège anti-spam (Web3Forms) : invisible pour les visiteurs, doit rester décoché -->
  <input type="checkbox" name="botcheck" class="hidden" style="display: none" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="grid gap-x-[46px] gap-y-2 sm:grid-cols-2">
    <div>
      <label for="nom" class={label}>Nom<span aria-hidden="true">*</span></label>
      <input id="nom" name="nom" type="text" autocomplete="family-name" required class={input} />
    </div>
    <div>
      <label for="prenom" class={label}>Prénom<span aria-hidden="true">*</span></label>
      <input id="prenom" name="prenom" type="text" autocomplete="given-name" required class={input} />
    </div>
    <div>
      <label for="telephone" class={label}>Téléphone<span aria-hidden="true">*</span></label>
      <input id="telephone" name="telephone" type="tel" autocomplete="tel" required pattern="[0-9+().\s\-]{10,}" class={input} />
    </div>
    <div>
      <label for="email" class={label}>Email<span aria-hidden="true">*</span></label>
      <input id="email" name="email" type="email" autocomplete="email" required class={input} />
    </div>
  </div>

  <fieldset class="mt-3">
    <legend class={label}>Votre projet concerne<span aria-hidden="true"> *</span></legend>
    <div class="mt-2 flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:justify-between">
      {
        projectOptions.map((option, i) => (
          <label class="flex cursor-pointer items-center gap-2 text-[0.85rem] text-ink">
            <input
              type="radio"
              name="projet"
              value={option}
              required={i === 0}
              class="h-4 w-4 accent-olive-dark"
            />
            {option}
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="mt-2">
    <label for="message" class={label}>Parlez-nous de votre projet<span aria-hidden="true">*</span></label>
    <textarea id="message" name="message" rows="2" required class:list={[input, 'h-auto min-h-[62px] resize-y']}></textarea>
  </div>

  <label class="mt-3 flex items-start gap-2 text-[0.8rem] leading-snug text-ink/80">
    <input type="checkbox" name="consentement" value="oui" required class="mt-0.5 h-4 w-4 shrink-0 accent-olive-dark" />
    <span>
      J’accepte que mes données soient utilisées pour être contacté
      (<a href="/mentions-legales/#donnees" class="underline">en savoir plus</a>).<span aria-hidden="true">*</span>
    </span>
  </label>

  <Button type="submit" variant="submit" class="mt-3 min-h-[38px] py-1.5 md:text-[1.05rem]">Envoyer</Button>
  <p class="mt-1 text-[0.7rem] text-ink/50">Les champs marqués d’un * sont obligatoires</p>

  <p class="mt-3 hidden px-3 py-2 text-sm" role="status" aria-live="polite" data-form-status></p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const fallbackError = `Une erreur est survenue lors de l’envoi. Réessayez ou écrivez-nous à ${form?.dataset.email}.`;
  const status = form?.querySelector<HTMLElement>('[data-form-status]');

  const show = (message: string, ok: boolean) => {
    if (!status) return;
    status.textContent = message;
    status.classList.remove('hidden', 'bg-[#e6ead9]', 'bg-[#f3dfdb]');
    status.classList.add(ok ? 'bg-[#e6ead9]' : 'bg-[#f3dfdb]');
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    show('Envoi en cours…', true);

    try {
      const data = Object.fromEntries(new FormData(form));
      delete data.redirect; // la redirection ne sert qu'à l'envoi sans JavaScript
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(data),
      });
      const result = await response.json().catch(() => null);
      if (!response.ok || !result?.success) {
        // Les messages d'erreur de Web3Forms sont en anglais : on affiche le message générique.
        show(fallbackError, false);
        return;
      }
      form.reset();
      show('Merci ! Votre message a bien été envoyé. Nous revenons vers vous dans les meilleurs délais.', true);
    } catch {
      show(fallbackError, false);
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
