---
// Pied de page : absent des maquettes, conçu sobrement avec le système de design (cf. docs/ANALYSE_MAQUETTES.md § 0.3).
import Logo from './Logo.astro';
import Sprig from './Sprig.astro';
import { navItems, site } from '../data/site';

const links = navItems;
const year = new Date().getFullYear();
---

<footer class="bg-olive-dark text-cream">
  <div class="container-site grid gap-10 py-12 md:grid-cols-[1.2fr_1fr_1fr] md:gap-8">
    <div class="flex flex-col items-start gap-4">
      <Logo inverted />
      <p class="max-w-xs font-serif text-lg italic text-cream/85">
        Nous prenons soin de votre propriété comme si elle était la nôtre.
      </p>
    </div>

    <nav aria-label="Plan du site">
      <h2 class="mb-4 font-sans text-sm font-semibold uppercase tracking-[0.15em] text-cream/70">Navigation</h2>
      <ul class="grid grid-cols-2 gap-x-6 gap-y-2 text-[0.95rem]">
        {links.map((item) => (
          <li><a class="underline-offset-4 hover:underline" href={item.href}>{item.label}</a></li>
        ))}
        <li><a class="underline-offset-4 hover:underline" href="/a-propos/#notre-territoire">Notre territoire</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="mb-4 font-sans text-sm font-semibold uppercase tracking-[0.15em] text-cream/70">Contact</h2>
      <address class="space-y-2 not-italic text-[0.95rem]">
        <p>{site.name} — {site.town}</p>
        <p><a class="underline-offset-4 hover:underline" href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
        <p><a class="underline-offset-4 hover:underline" href={`mailto:${site.email}`}>{site.email}</a></p>
      </address>
    </div>
  </div>

  <div class="border-t border-cream/15">
    <div class="container-site flex flex-col items-center justify-between gap-3 py-5 text-sm text-cream/75 sm:flex-row">
      <p class="flex items-center gap-3"><Sprig class="h-6 w-8" /> © {year} {site.name}</p>
      <a class="underline-offset-4 hover:underline" href="/mentions-legales/">Mentions légales &amp; confidentialité</a>
    </div>
  </div>
</footer>
