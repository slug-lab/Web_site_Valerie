---
import Divider from './Divider.astro';
import Icon, { type IconName } from './Icon.astro';
import Sprig from './Sprig.astro';

interface Props {
  title: string;
  icon: IconName;
  pitch: string;
  services: string[];
  footerColor: 'olive' | 'gold';
  /** Espacement réduit entre les prestations (liste plus longue). */
  compact?: boolean;
  class?: string;
}
const { title, icon, pitch, services, footerColor, compact = false, class: className = 'h-full' } = Astro.props;
---

<article class:list={['flex flex-col bg-cream-card', className]}>
  <div class="flex flex-1 flex-col px-6 pt-1 pb-4 lg:px-[30px]">
    <Icon name={icon} class="mx-auto h-[50px] w-[50px] text-olive-dark" />
    <h3 class="mt-1 text-center font-serif text-[1.65rem] font-semibold text-olive-dark">{title}</h3>
    <Divider class="mx-auto mt-2 w-full max-w-[258px]" sprigClass="h-4 w-9 text-[#b6a592]" lineClass="bg-[#c9b9a6]" />
    <p class="mt-3 text-center font-serif text-[1.15rem] font-semibold italic leading-tight text-olive-dark">{pitch}</p>
    <ul class:list={['mt-3 text-[0.85rem]', compact ? 'space-y-[13px]' : 'space-y-[17px]', 'leading-snug text-ink/90']}>
      {services.map((service) => <li>{service}</li>)}
    </ul>
  </div>
  <div
    class:list={[
      'relative flex min-h-[72px] flex-col items-center justify-center py-2 pl-12 pr-5 text-center font-serif text-white',
      footerColor === 'olive' ? 'bg-olive' : 'bg-[#a38b62]',
    ]}
  >
    <Sprig class="absolute left-4 top-1/2 h-4 w-9 -translate-y-1/2 -rotate-[65deg] text-white/70" />
    <slot />
  </div>
</article>
